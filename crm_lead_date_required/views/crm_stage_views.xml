<odoo>

    <record id="crm_stage_form" model="ir.ui.view">
        <field name="name">crm.stage.form.require_expected_date</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="require_expected_date"/>
            </xpath>
        </field>
    </record>

    <record id="crm_stage_tree" model="ir.ui.view">
        <field name="name">crm.stage.tree.require_expected_date</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='probability']" position="after">
                <field name="require_expected_date"/>
            </xpath>
        </field>
    </record>

</odoo>
